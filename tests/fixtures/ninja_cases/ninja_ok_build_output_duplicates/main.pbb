|{ cwd, pb, ... }|
let
    touch_rule = pb.rule (
        |{ input, output }| {
            command = [ "touch", output ];
        }
    );
    cat_rule = pb.rule (
        |{ input, output }| {
            command = [ "cat", input, ">", output ];
        }
    );
    build_output = touch_rule {
        input = cwd / "src.in";
        output = [
            cwd / "a.out",
            [ cwd / "a.out", cwd / "b.out" ],
        ];
    };
in
cat_rule {
    input = build_output;
    output = cwd / "all";
}
