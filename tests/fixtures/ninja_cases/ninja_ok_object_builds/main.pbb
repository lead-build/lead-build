|{ cwd, pb, ... }|
let
    cp_rule = pb.rule (
        |{ input, output }| {
            command = [ "cp", input, output ];
        }
    );
in
{
    first = cp_rule {
        input = cwd / "a.in";
        output = cwd / "a.out";
    };
    second = cp_rule {
        input = cwd / "b.in";
        output = cwd / "b.out";
    };
}
