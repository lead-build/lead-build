|{ cwd, pb, ... }|
let
    cp_rule = pb.rule (
        |{ input, output }| {
            command = [ "cp", input, output ];
        }
    );
    dep = pb.build {
        rule = cp_rule;
        input = cwd / "dep.in";
        output = cwd / "dep.out";
    };
in
pb.build {
    rule = cp_rule;
    input = cwd / "main.in";
    output = cwd / "main.out";
    deps = dep;
}
